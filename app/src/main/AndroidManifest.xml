<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Limit READ_EXTERNAL_STORAGE to Android 12 (SDK 32) and lower.
        On Android 13+ (SDK 33+), we rely on the source app (File Manager/OneDrive)
        granting us URI permissions via the Intent.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitsViewer"
        android:largeHeap="true"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FitsViewer"
            tools:ignore="RedundantLabel">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                The app must only be offered for FITS files, never as a generic
                "open anything" handler. So there is deliberately no */* or
                application/octet-stream filter without a file-name check.
            -->

            <!-- FILTER 1: Real FITS MIME types (any file name) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="image/fits" />
                <data android:mimeType="application/fits" />
                <data android:mimeType="image/x-fits" />
                <data android:mimeType="application/x-fits" />
            </intent-filter>

            <!--
                FILTER 2: Any MIME type (many file managers report FITS as
                application/octet-stream), but ONLY when the file name ends in
                .fits / .fit / .fts. MIME type and path must both match.
            -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathSuffix=".fits" />
                <data android:pathSuffix=".fit" />
                <data android:pathSuffix=".fts" />
                <data android:pathSuffix=".FITS" />
                <data android:pathSuffix=".FIT" />
                <data android:pathSuffix=".FTS" />
                <data android:pathSuffix=".Fits" />
                <data android:pathSuffix=".Fit" />
                <data android:pathSuffix=".Fts" />
                <data android:pathPattern=".*\\.fits" />
                <data android:pathPattern=".*\\.fit" />
                <data android:pathPattern=".*\\.fts" />
                <data android:pathPattern=".*\\.FITS" />
                <data android:pathPattern=".*\\.FIT" />
                <data android:pathPattern=".*\\.FTS" />
                <data android:pathPattern=".*\\.Fits" />
                <data android:pathPattern=".*\\.Fit" />
                <data android:pathPattern=".*\\.Fts" />
                <data android:pathPattern=".*\\..*\\.fits" />
                <data android:pathPattern=".*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\.fts" />
                <data android:pathPattern=".*\\..*\\.FITS" />
                <data android:pathPattern=".*\\..*\\.FIT" />
                <data android:pathPattern=".*\\..*\\.FTS" />
                <data android:pathPattern=".*\\..*\\.Fits" />
                <data android:pathPattern=".*\\..*\\.Fit" />
                <data android:pathPattern=".*\\..*\\.Fts" />
                <data android:pathPattern=".*\\..*\\..*\\.fits" />
                <data android:pathPattern=".*\\..*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\..*\\.fts" />
                <data android:pathPattern=".*\\..*\\..*\\.FITS" />
                <data android:pathPattern=".*\\..*\\..*\\.FIT" />
                <data android:pathPattern=".*\\..*\\..*\\.FTS" />
                <data android:pathPattern=".*\\..*\\..*\\.Fits" />
                <data android:pathPattern=".*\\..*\\..*\\.Fit" />
                <data android:pathPattern=".*\\..*\\..*\\.Fts" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.fits" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.fts" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.FITS" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.FIT" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.FTS" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.Fits" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.Fit" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.Fts" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.fits" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.fts" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.FITS" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.FIT" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.FTS" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.Fits" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.Fit" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.Fts" />
            </intent-filter>

            <!-- FILTER 3: Same file-name check for intents sent without a MIME type -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:pathSuffix=".fits" />
                <data android:pathSuffix=".fit" />
                <data android:pathSuffix=".fts" />
                <data android:pathSuffix=".FITS" />
                <data android:pathSuffix=".FIT" />
                <data android:pathSuffix=".FTS" />
                <data android:pathSuffix=".Fits" />
                <data android:pathSuffix=".Fit" />
                <data android:pathSuffix=".Fts" />
                <data android:pathPattern=".*\\.fits" />
                <data android:pathPattern=".*\\.fit" />
                <data android:pathPattern=".*\\.fts" />
                <data android:pathPattern=".*\\.FITS" />
                <data android:pathPattern=".*\\.FIT" />
                <data android:pathPattern=".*\\.FTS" />
                <data android:pathPattern=".*\\.Fits" />
                <data android:pathPattern=".*\\.Fit" />
                <data android:pathPattern=".*\\.Fts" />
                <data android:pathPattern=".*\\..*\\.fits" />
                <data android:pathPattern=".*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\.fts" />
                <data android:pathPattern=".*\\..*\\.FITS" />
                <data android:pathPattern=".*\\..*\\.FIT" />
                <data android:pathPattern=".*\\..*\\.FTS" />
                <data android:pathPattern=".*\\..*\\.Fits" />
                <data android:pathPattern=".*\\..*\\.Fit" />
                <data android:pathPattern=".*\\..*\\.Fts" />
                <data android:pathPattern=".*\\..*\\..*\\.fits" />
                <data android:pathPattern=".*\\..*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\..*\\.fts" />
                <data android:pathPattern=".*\\..*\\..*\\.FITS" />
                <data android:pathPattern=".*\\..*\\..*\\.FIT" />
                <data android:pathPattern=".*\\..*\\..*\\.FTS" />
                <data android:pathPattern=".*\\..*\\..*\\.Fits" />
                <data android:pathPattern=".*\\..*\\..*\\.Fit" />
                <data android:pathPattern=".*\\..*\\..*\\.Fts" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.fits" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.fts" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.FITS" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.FIT" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.FTS" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.Fits" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.Fit" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.Fts" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.fits" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.fit" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.fts" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.FITS" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.FIT" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.FTS" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.Fits" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.Fit" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.Fts" />
            </intent-filter>

            <!-- Share: only for FITS MIME types -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/fits" />
                <data android:mimeType="application/fits" />
                <data android:mimeType="image/x-fits" />
                <data android:mimeType="application/x-fits" />
            </intent-filter>

        </activity>
    </application>
</manifest>